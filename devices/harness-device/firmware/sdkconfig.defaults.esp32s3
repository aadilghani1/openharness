# The round dial (ESP32-S3-Touch-AMOLED-1.75C) — everything the Pro does not share.
#
# Split out of sdkconfig.defaults when the Pro's ESP32-P4 target arrived; the values are unchanged from
# what shipped, so a dial built before and after the split gets the same sdkconfig.
#
# CONFIG_IDF_TARGET lives here rather than in the shared file so that `idf.py build` in a fresh
# checkout still means "the dial" — ESP-IDF falls back to this when nothing else names a target.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- PSRAM (ESP32-S3R8 = 8MB octal PSRAM; LVGL object pool lives here) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- WiFi (STA for commander, AP for provisioning portal) ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# --- HTTP server (captive portal) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# --- WebSocket client ---
CONFIG_WS_TRANSPORT=y

# --- TLS (wss:// + https:// to the prod backend) ---
# Verify the prod cert chain against Mozilla's CA roots via esp_crt_bundle_attach.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Leave CONFIG_MBEDTLS_HAVE_TIME_DATE OFF (default) so the TLS handshake does NOT depend on a synced
# clock — REST pairing runs before SNTP, and cert validity dates are not enforced.
# Allocate mbedTLS buffers (~32KB per TLS conn: two 16KB record buffers) from the 8MB PSRAM instead
# of the ~150KB internal heap. Internal heap fragments after the first few TLS connections, so the
# persistent commander WSS + periodic REST fail ssl_setup with -0x7F00 (ALLOC_FAILED) / sock<0.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- LWIP: room for commander WS + HTTP client + DNS concurrently ---
CONFIG_LWIP_MAX_SOCKETS=16
# Larger TCP send/recv buffers so continuous voice PCM streaming tolerates WiFi jitter
# (default ~5.7KB fills in ~180ms at 32KB/s → esp_websocket_client tears down on write-0).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
