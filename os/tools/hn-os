#!/usr/bin/env python3
"""System operations callable from an agent's ordinary shell."""
import json
import os
from pathlib import Path
import subprocess
import sys


def main():
    args = sys.argv[1:]
    command = args.pop(0) if args else 'status'
    if command == 'install':
        os.execv('/usr/bin/python3', ['python3', '/usr/lib/harness-os/install.py', *args])
    if command == 'browser':
        os.execv('/usr/bin/hn-browser', ['hn-browser', *args])
    if command in ['checkpoint', 'update', 'recover']:
        os.execv('/usr/bin/python3', ['python3', '/usr/lib/harness-os/system.py', command, *args])
    if command == 'status':
        print(Path('/usr/share/harness-os/lock.json').read_text())
        subprocess.run(['systemctl', '--user', '--no-pager', 'status', 'harness-daemon', 'hn-screen'])
        return
    if command == 'measure':
        data = {'uptime': Path('/proc/uptime').read_text().split()[0],
                'memory': Path('/proc/meminfo').read_text(),
                'boot': subprocess.check_output(['systemd-analyze'], text=True),
                'processes': subprocess.check_output(['ps', '-eo', 'comm,rss,pcpu', '--sort=-rss'], text=True)}
        print(json.dumps(data, indent=2))
        return
    raise SystemExit('Usage: hn-os [status | install | browser [URL] | measure | checkpoint | update [--snapshot YYYY/MM/DD] | recover ROOT_DEVICE [CHECKPOINT]]')


if __name__ == '__main__':
    main()
